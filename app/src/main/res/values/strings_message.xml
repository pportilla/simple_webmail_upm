<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Conversation states -->
    <string name="message_not_found_title">Message not available</string>
    <string name="message_not_found_body">It may have been deleted or moved to another folder.</string>
    <plurals name="message_more_messages">
        <item quantity="one">%1$d more message</item>
        <item quantity="other">%1$d more messages</item>
    </plurals>

