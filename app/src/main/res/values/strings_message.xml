    <plurals name="message_attachment_count">
        <item quantity="one">%1$d attachment</item>
        <item quantity="other">%1$d attachments</item>
    </plurals>
    <string name="message_attachment_downloading">Downloading…</string>
    <string name="message_attachment_options">Options for %1$s</string>
