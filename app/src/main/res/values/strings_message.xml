    <string name="message_has_attachments">Has attachments</string>
    <string name="message_starred">Starred</string>
    <!-- Recipient line under the sender, e.g. "to me, Ana" -->
    <string name="message_to_summary">to %1$s</string>
    <plurals name="message_to_summary_more">
        <item quantity="one">to %1$s and %2$d more</item>
        <item quantity="other">to %1$s and %2$d more</item>
    </plurals>
