    <string name="message_print">Print</string>
    <string name="message_print_failed">Couldn\'t print this message</string>
    <string name="message_archived">Conversation archived</string>
    <string name="message_trashed">Conversation moved to Trash</string>
    <string name="message_deleted_forever">Conversation deleted forever</string>
    <string name="message_single_trashed">Message moved to Trash</string>
