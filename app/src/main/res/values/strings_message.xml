    <plurals name="message_delete_body">
        <item quantity="one">%1$d message will be moved to Trash.</item>
        <item quantity="other">%1$d messages will be moved to Trash.</item>
    </plurals>
    <string name="message_delete_forever_title">Delete forever?</string>
    <plurals name="message_delete_forever_body">
        <item quantity="one">%1$d message will be permanently deleted. You can\'t undo this.</item>
        <item quantity="other">%1$d messages will be permanently deleted. You can\'t undo this.</item>
    </plurals>
    <string name="message_delete_single_title">Delete this message?</string>
    <string name="message_delete_single_body">It will be moved to Trash.</string>
    <string name="message_delete_single_forever_body">It will be permanently deleted. You can\'t undo this.</string>

    <!-- Unsubscribe -->
    <string name="message_unsubscribe">Unsubscribe</string>
    <string name="message_unsubscribe_title">Unsubscribe?</string>
    <string name="message_unsubscribe_title_from">Unsubscribe from %1$s?</string>
    <string name="message_unsubscribe_web">The unsubscribe page of %1$s will open in your browser.</string>
    <string name="message_unsubscribe_mail">A message to %1$s will be prepared. Send it to stop receiving these emails.</string>
    <!-- Subject of the unsubscribe e-mail when the sender does not suggest one; kept in English on purpose for mailing-list robots -->
    <string name="message_unsubscribe_default_subject">unsubscribe</string>
</resources>
